generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("analyst") // analyst, admin
  status    String   @default("Active")  // Active, Inactive
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Alert {
  id            String   @id @default(uuid())
  title         String
  severity      String   // critical, high, medium, low
  status        String   @default("new") // new, investigating, resolved
  source        String
  description   String?
  timestamp     DateTime @default(now())
  entity        String?  // The asset or user involved
  sourceIp      String?
  destIp        String?
  assignedTo    String?  // User ID
  caseId        String?  // The case this alert belongs to
  case          Case?    @relation(fields: [caseId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Case {
  id          String   @id @default(uuid())
  title       String
  description String?
  status      String   @default("open")
  priority    String   @default("medium")
  assignedTo  String?
  notes       String?  // Analyst investigation notes
  resolution  String?  // Resolution summary
  alerts      Alert[]
  incidentIocs CaseIoc[]
  incidentRules CaseRule[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CaseIoc {
  caseId String
  iocId  String
  case   Case @relation(fields: [caseId], references: [id])
  ioc    Ioc  @relation(fields: [iocId], references: [id])
  @@id([caseId, iocId])
}

model CaseRule {
  caseId String
  ruleId String
  case   Case @relation(fields: [caseId], references: [id])
  rule   Rule @relation(fields: [ruleId], references: [id])
  @@id([caseId, ruleId])
}

model ThreatActor {
  id          String   @id @default(uuid())
  name        String   @unique
  type        String?  // e.g., "State-sponsored", "Cybercrime"
  origin      String?
  description String?
  lastSeen    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Ioc {
  id          String   @id @default(uuid())
  type        String   // ip, domain, hash
  value       String   @unique
  name        String?
  description String?
  pattern     String?
  confidence  Int?     // 0-100 score from OpenCTI
  severity    String?  // low, medium, high, critical
  lastEnriched   DateTime?
  rules        Rule[]
  cases        CaseIoc[]
  seenAt      DateTime @default(now())
  createdAt   DateTime @default(now())
}

model Rule {
  id          String   @id @default(uuid())
  indicatorId String?
  indicator   Ioc?     @relation(fields: [indicatorId], references: [id])
  type        String   // NAXSI_MAIN, NAXSI_BASIC
  content     String   // The actual rule string
  status      String   @default("pending") // pending, active, disabled, rejected, failed, rolled_back
  source      String   // OpenCTI, Manual
  lastVerified DateTime?
  verificationStatus String? // success, failed
  cases        CaseRule[]
  naxsiId     Int?     @unique // The sequential ID within its category range
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  action      String   // e.g., "RULE_APPROVED", "SYNC_MANUAL", "LOGIN"
  entityType  String?  // e.g., "Rule", "Case", "Ioc"
  entityId    String?
  details     String?  // JSON stringified
  timestamp   DateTime @default(now())
}

model SyncStatus {
  id          String   @id @default(uuid())
  serviceName String   @unique
  lastSync    DateTime @default(now())
  status      String   // success, error
  message     String?
  iocCount    Int      @default(0)
  freshness   Int?     // indicators updated in last sync
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Campaign {
  id          String   @id @default(uuid())
  title       String
  status      String   @default("Active")   // Active, Investigating, Contained, Resolved
  severity    String   @default("Medium")   // Critical, High, Medium, Low
  description String?
  actor       String?                        // linked threat actor name
  indicators  Int      @default(0)
  startDate   DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Integration {
  id        String   @id @default(uuid())
  name      String   @unique // siem, slack, virustotal, misp
  apiKey    String?
  endpoint  String?
  status    String   @default("Off") // Connected, Off
  config    String?  // JSON stringified configuration
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkspaceSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  type      String   @default("string") // string, number, boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
