# ── Server Configuration ──────────────────────────────────────────────────────
PORT=5000
JWT_SECRET=817be203d910de88235df72bf7c0ce872d03893db4938fd8dc46356ce36e2ce26a7c6a13fd08eac44a5fe869e64cde54
CLIENT_ORIGIN=http://localhost:3000

# ── Database Configuration (PostgreSQL) ───────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/soc_dashboard?schema=public"

# ── Threat Intelligence (OpenCTI) ─────────────────────────────────────────────
# Set MOCK_OPENCTI=true to use internal demo data when OpenCTI is unavailable
MOCK_OPENCTI=true
OPENCTI_URL=http://localhost:8080/graphql
OPENCTI_TOKEN=your_token_here

# ── Firewall Simulation (NAXSI) ───────────────────────────────────────────────
# If set to true, the server will simulate rule generation and Nginx reloads
SIMULATE_FIREWALL=true
NAXSI_RULES_PATH=./config/naxsi_rules.conf
FIREWALL_RELOAD_CMD="nginx -s reload"
