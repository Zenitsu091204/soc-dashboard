# ── Server ────────────────────────────────────────────────────────────────────
PORT=8001
NODE_ENV=production
# The FQDN of your dashboard (e.g., https://soc.company.com)
CLIENT_ORIGIN=http://localhost:8000

# ── Database ──────────────────────────────────────────────────────────────────
# Example: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/soc_dashboard?schema=public"

# ── Authentication ────────────────────────────────────────────────────────────
# REQUIRED: Generate a strong secret — e.g. `node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"`
JWT_SECRET="change_this_to_a_strong_random_secret_before_deploying_to_production"

# ── CORS ──────────────────────────────────────────────────────────────────────
# Frontend origin (comma-separated for multiple origins)
CLIENT_ORIGIN=http://localhost:3000

# ── OpenCTI Integration (Optional) ───────────────────────────────────────────
# Leave blank to disable OpenCTI sync. System returns empty results when unconfigured — NO mock data.
OPENCTI_URL=
OPENCTI_TOKEN=

# ── Firewall Integration (Optional) ──────────────────────────────────────────
# Path to write NAXSI rules file
# NAXSI_RULES_PATH=/etc/nginx/naxsi_rules.conf
# Command to reload the firewall after rule deployment
# FIREWALL_RELOAD_CMD=nginx -s reload
# Set to 'true' to skip actual file writes and firewall reload in development
SIMULATE_FIREWALL=true
