{
  "name": "soc-dashboard-root",
  "version": "1.0.0",
  "description": "Unified orchestration for SOC Dashboard",
  "scripts": {
    "install:all": "npm install && npm install --prefix client && npm install --prefix server",
    "setup": "node setup.js",
    "server": "npm run dev --prefix server",
    "client": "npm start --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "db:migrate": "npx prisma migrate dev --name init --schema=server/prisma/schema.prisma",
    "db:seed": "node server/prisma/seed.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "wait-on": "^7.2.0"
  }
}
