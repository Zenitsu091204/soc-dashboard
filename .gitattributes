# Handle line endings automatically for files detected as text
# and leave files detected as binary untouched.
* text=auto

# Force LF line endings on checkout for all text source files
*.js     text eol=lf
*.css    text eol=lf
*.html   text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.txt    text eol=lf
*.prisma text eol=lf
*.sh     text eol=lf
*.env    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf

# Binary files — never touch line endings
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.svg  text eol=lf
