# SOC Dashboard - Nginx Production Configuration Template
# Path: /etc/nginx/sites-available/soc-dashboard

server {
    listen 80;
    server_name YOUR_DOMAIN_OR_IP;

    # Redirect HTTP to HTTPS (Recommended for Production)
    # return 301 https://$host$request_uri;

    location / {
        proxy_pass http://localhost:8001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        
        # ── NAXSI Integration ──────────────────────────────────────────────
        # Enable NAXSI on this location
        # SecRulesEnabled;
        # LearningMode; # Enable this first to tune rules
        # LibInjectionSql;
        # LibInjectionXss;
        
        # Deny on matches
        # CheckRule "$SQL >= 8" BLOCK;
        # CheckRule "$XSS >= 8" BLOCK;
        # CheckRule "$RCE >= 8" BLOCK;
        # CheckRule "$TRAVERSAL >= 8" BLOCK;
        
        # Include the STIX-derived rules generated by the dashboard
        # include /etc/nginx/naxsi_rules.conf;

        # Error page for blocked requests
        # error_page 403 /403.html;
    }

    # API and Static Assets are handled by the Node.js server
    # but could be further optimized by Nginx direct serving if needed.
}
